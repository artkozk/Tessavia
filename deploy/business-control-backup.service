[Unit]
Description=Encrypted verified local backup of BizFlow database and attachments
After=business-control.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/business-control.env
ExecStart=/usr/local/sbin/business-control-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/business-control /var/backups/business-control
