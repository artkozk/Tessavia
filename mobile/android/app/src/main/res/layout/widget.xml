<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand" android:textSize="11sp" android:letterSpacing="0.12" android:textColor="#64756C" />
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preview_title" android:textColor="#202D26" android:textStyle="bold" android:textSize="19sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/progress_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preview_progress" android:textSize="15sp" android:textStyle="bold" android:textColor="#126B58" android:layout_marginTop="8dp" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressTint="#126B58" android:progressBackgroundTint="#DEE4DE" android:max="100" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/items" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#37493D" android:textSize="13sp" android:lineSpacingExtra="4dp" android:maxLines="4" android:ellipsize="end" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preview_status" android:textColor="#64756C" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <TextView android:id="@+id/open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/open" android:textColor="#126B58" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="8dp" android:text="@string/refresh" android:textColor="#126B58" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
